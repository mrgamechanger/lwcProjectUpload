<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <hasActivationRequired>false</hasActivationRequired>
    <label>SalesFrc Forecast Access</label>
    <description>
        Grants execute access to Forecast Apex classes and read access to Forecast Summary object for dashboard usage.
        Follow-up: create narrower sets if needed per governance (Read/Write/Execute). This baseline keeps to minimal access.
    </description>

    <!-- Apex Class Access -->
    <classAccesses>
        <apexClass>ForecastApexProxy</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ForecastEngine</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ForecastBatch</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ForecastScheduler</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ForecastRestController</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <!-- Object & Field Permissions: Forecast_Summary__c (Read for dashboard) -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Forecast_Summary__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- Field-level security (Read) -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Forecast_Summary__c.Grain__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Forecast_Summary__c.PeriodStartDate__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Forecast_Summary__c.FiscalYear__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Forecast_Summary__c.FiscalQuarter__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Forecast_Summary__c.Owner__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Forecast_Summary__c.Team__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Forecast_Summary__c.Territory2Id__c</field>
