<apex:page renderAs="pdf" controller="RecordPdfController" applyHtmlTag="false" showHeader="false" standardStylesheets="false">
    <head>
        <style>
            body {
                font-family: Arial, sans-serif;
                font-size: 12px;
                color: #333;
                margin: 0;
                padding: 20px;
            }
            .header {
                text-align: center;
                margin-bottom: 20px;
                border-bottom: 1px solid #ccc;
                padding-bottom: 10px;
            }
            .header h1 {
                color: #0070d2;
                font-size: 24px;
                margin: 0;
            }
            .header p {
                color: #666;
                font-size: 14px;
                margin: 5px 0;
            }
            .content {
                margin-top: 20px;
            }
            .field {
                margin-bottom: 10px;
            }
            .field-label {
                font-weight: bold;
                color: #666;
            }
            .field-value {
                margin-left: 10px;
            }
            .footer {
                margin-top: 30px;
                text-align: center;
                font-size: 10px;
                color: #999;
                border-top: 1px solid #ccc;
                padding-top: 10px;
            }
        </style>
    </head>
    <body>
        <div class="header">
            <h1>{!record.Name}</h1>
            <p>Record Details</p>
        </div>
        
        <div class="content">
            <div class="field">
                <span class="field-label">Record ID:</span>
                <span class="field-value">{!record.Id}</span>
            </div>
            
            <div class="field">
                <span class="field-label">Name:</span>
                <span class="field-value">{!record.Name}</span>
            </div>
            
            <div class="field">
                <span class="field-label">Description:</span>
                <span class="field-value">{!record.Description}</span>
            </div>
            
            <div class="field">
                <span class="field-label">Created Date:</span>
                <span class="field-value">{!record.CreatedDate}</span>
            </div>
            
            <div class="field">
                <span class="field-label">Last Modified:</span>
                <span class="field-value">{!record.LastModifiedDate}</span>
            </div>
            
            <div class="field">
                <span class="field-label">Owner:</span>
                <span class="field-value">{!record.Owner.Name}</span>
            </div>
        </div>
        
        <div class="footer">
            <p>Generated on {!NOW} | {!$Organization.Name}</p>
        </div>
    </body>
</apex:page> 