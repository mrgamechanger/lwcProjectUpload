<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Electricity Consumption Bar Chart</masterLabel>
    <description>Displays a bar chart of daily electricity consumption (kWh) with dates on X-axis and consumption on Y-axis. Accepts JSON via @api chartData.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__Tab</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>*</object>
            </objects>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
